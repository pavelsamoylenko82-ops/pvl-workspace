# Telegram
BOT_TOKEN=123456789:replace_with_bot_token
ADMIN_ID=853218288
# Дополнительные Telegram ID владельца через запятую (необязательно)
# ALLOWED_USER_IDS=123456789

# Google Sheets: путь к JSON-ключу service account и ID таблицы SAMOLA CRM
# Windows:
GOOGLE_CREDS_PATH=D:\учеба\PVL\tools\google_creds.json
# Linux (VPS):
# GOOGLE_CREDS_PATH=/opt/pvl-workspace/tools/google_creds.json
SPREADSHEET_ID=16JYC1URl2anD0rEDogs37ZV2aej3O1wLDR1F_K1z2ro

# Куда складывать ежедневные JSON-бэкапы (по умолчанию backups/ рядом с ботом)
BACKUPS_DIR=backups

# Часовой пояс меню, напоминаний, сводки и разбора дат
TIMEZONE=Europe/Minsk

# --- ИИ-обновление CRM текстом и голосом (обязательно для этой функции) ---
# Если ключа нет в .env бота, он ищется в корневом .env и .env соседних проектов.
DEEPSEEK_API_KEY=sk-replace_with_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# --- Локальное распознавание голоса (faster-whisper, CPU) ---
# tiny или base. Модель скачивается один раз в WHISPER_DOWNLOAD_ROOT и живёт в памяти.
WHISPER_MODEL=tiny
WHISPER_LANGUAGE=ru
WHISPER_COMPUTE_TYPE=int8
WHISPER_DEVICE=cpu
# WHISPER_DOWNLOAD_ROOT=models

# --- Необязательное: старые локальные скрипты (бот их больше не использует) ---
# WORKSPACE_DIR=D:\учеба\PVL
# GIT_SYNC=false
