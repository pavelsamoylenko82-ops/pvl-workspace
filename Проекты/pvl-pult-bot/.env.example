# Telegram
BOT_TOKEN=123456789:replace_with_bot_token
ADMIN_ID=853218288

# Рабочая папка с Карточки/, ДЕЛА.md и собрать.py
# Windows:
WORKSPACE_DIR=D:\учеба\PVL
# Linux пример: WORKSPACE_DIR=/opt/pvl-workspace

# Git-синхронизация: true включает pull/push, false оставляет всё локально
GIT_SYNC=false

# DeepSeek: строго официальный OpenAI-совместимый endpoint chat/completions
DEEPSEEK_API_KEY=sk-replace_with_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# Можно также указать DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# Код сам добавит /chat/completions и не продублирует /v1.

# Часовой пояс утреннего дайджеста
TIMEZONE=Europe/Minsk
